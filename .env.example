# Postgres. Op Railway: ${{Postgres.DATABASE_URL}}
DATABASE_URL=postgres://postgres:postgres@localhost:5432/nagtzaam_hub

# Lange willekeurige string (minstens 32 tekens), bijv. `openssl rand -base64 48`
SESSION_SECRET=

# Eerste traineraccount; wordt bij de eerste start aangemaakt als er nog geen gebruikers zijn
TRAINER_EMAIL=
TRAINER_NAME=
TRAINER_PASSWORD=

# Optioneel: beheerder van de trainers (standaard TRAINER_EMAIL)
ADMIN_EMAIL=

# Mail (eigen mailbox via SMTP) voor uitnodigingen en wachtwoord vergeten
APP_URL=
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
MAIL_FROM=
