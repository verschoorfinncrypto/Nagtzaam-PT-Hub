  },
  "dependencies": {
    "bcryptjs": "2.4.3",
    "drizzle-orm": "0.45.2",
    "jose": "5.9.6",
    "next": "14.2.35",
    "pg": "8.13.1",
    "react": "18.3.1",
    "react-dom": "18.3.1",
    "server-only": "^0.0.1",
    "zod": "3.23.8"
  },
  "devDependencies": {
    "@types/bcryptjs": "2.4.6",
    "@types/node": "20.17.6",
    "@types/pg": "8.11.10",
    "@types/react": "18.3.12",
    "@types/react-dom": "18.3.1",
    "drizzle-kit": "0.31.10",
    "typescript": "5.6.3"
  }
